    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "node-cache": "^5.1.2",
    "pdf-parse": "^1.1.1",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "javascript-obfuscator": "^4.1.0",
    "clean-css-cli": "^5.6.3"
  },
  "engines": {
    "node": ">=18.x"
