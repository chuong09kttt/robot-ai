{
  "name": "chiri-ai-robot",
  "version": "13.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:obfuscate && npm run build:css",
